# --------------------------------------------------------------------------- #
# Copie este fichero a `.env` y complete los valores. No lo suba al repositorio.
#
# IMPORTANTE: no escriba comentarios en la misma línea que un valor.
# `python-dotenv` los tomaría como parte del valor, de modo que
# `ADMIN_API_KEY=   # comentario` daría una clave igual a "# comentario".
# Deje siempre el comentario en su propia línea, como aquí.
# --------------------------------------------------------------------------- #

# --------------------------------------------------------------- general ----
APP_NAME=ChatboxGlobal
# dev | staging | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO
# Dirección por la que el equipo accede al servicio; en una red local, la IP
# del servidor, por ejemplo http://192.168.1.50:8000
PUBLIC_BASE_URL=http://localhost:8000
DEFAULT_TENANT_SLUG=default

# -------------------------------------------------------------- postgres ----
DATABASE_URL=postgresql+asyncpg://chatbox:chatbox@localhost:5432/chatbox
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# -------------------------------------------------------------- WhatsApp ----
# Panel de Meta for Developers > WhatsApp > Configuración de la API.
# Cadena que usted elige al dar de alta el webhook: debe coincidir con la que
# se escriba en el panel de Meta al suscribir la URL del webhook.
WHATSAPP_VERIFY_TOKEN=
# App secret; valida la firma X-Hub-Signature-256. Meta for Developers >
# su app > Configuración > Básica > "Secreto de la aplicación". Obligatorio
# en producción; en desarrollo, si falta, solo se registra un aviso.
WHATSAPP_APP_SECRET=
# Token permanente del usuario del sistema.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Cuenta de WhatsApp Business del numero. Solo hace falta para listar
# las plantillas aprobadas al iniciar una conversacion saliente.
WHATSAPP_WABA_ID=
WHATSAPP_API_VERSION=v25.0

# -------------------------------------------------------------- Facebook ----
# Panel de Meta for Developers > Messenger > Configuración de la API. Cada
# página tiene su propio token de acceso, que se da de alta por cuenta desde
# la consola («Cuentas de canal»); aquí solo va lo común a todas las páginas
# de la misma app de Meta.
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v21.0

# ------------------------------------- Microsoft Bot Framework / Teams ------
# Portal de Azure > Azure Bot > Configuración.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
# Solo en modo SingleTenant.
MICROSOFT_APP_TENANT_ID=
# MultiTenant | SingleTenant
MICROSOFT_APP_TYPE=MultiTenant
# Desactívelo únicamente con el Bot Framework Emulator.
MICROSOFT_VALIDATE_JWT=true

# ------------------------------------------ SSO de la consola (SAML 2.0) ----
# Convive con el correo y contraseña de siempre: mientras falte cualquiera de
# estos tres datos, el botón «Iniciar sesión con SSO» queda oculto y nada más
# cambia. En Microsoft Entra ID: su app empresarial > Inicio de sesión único >
# SAML.
# "Identificador de Microsoft Entra" (Entra ID Identifier / Issuer).
SAML_IDP_ENTITY_ID=
# "URL de inicio de sesión" (Login URL).
SAML_IDP_SSO_URL=
# Certificado (Base64) del panel de Entra, sin las líneas
# "-----BEGIN/END CERTIFICATE-----" ni saltos de línea.
SAML_IDP_X509_CERT=
# Opcional: identidad de este servicio ante el IdP. Por omisión,
# PUBLIC_BASE_URL + "/saml/metadata" — ese es el valor que hay que dar de
# alta como "Identificador de entidad" en Entra si no se completa aquí.
SAML_SP_ENTITY_ID=

# --------------------------------------------- cuentas de canal (cifrado) ---
# Hace falta antes de dar de alta, desde la consola, una cuenta de WhatsApp o
# Facebook con su propio token de acceso (en vez del token global de arriba).
# Genere una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Cambiarla vuelve ilegibles las credenciales ya guardadas: habría que
# volver a cargarlas.
SECRET_ENCRYPTION_KEY=

# ------------------------------------------ SSO con Google (consola) --------
# Alternativa personal a SAML: convive con ella y con el login por
# contraseña. Google Cloud Console > APIs y servicios > Credenciales > ID de
# cliente de OAuth 2.0 (tipo "Aplicación web"), con
# PUBLIC_BASE_URL + /auth/google/callback como URI de redirección autorizado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------------------- correo saliente --
# Confirmación de registro del chatbox e invitación al crear un supervisor o
# administrador. Mientras falten usuario o contraseña, el correo simplemente
# no se envía y queda registrado en el log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Cuenta de Gmail / Google Workspace remitente.
SMTP_USERNAME=
# "Contraseña de aplicación" (myaccount.google.com/apppasswords), no la
# contraseña normal de la cuenta: Google la rechaza en SMTP.
SMTP_PASSWORD=
# Opcional: remitente que ve quien recibe el correo. Por omisión, SMTP_USERNAME.
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --------------------------------------------------------------------- IA ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_MAX_TOKENS=4096
# low | medium | high | xhigh | max
AI_EFFORT=medium
AI_HISTORY_TURNS=12

# ------------------------------------------------------------ orquestador ---
OUTBOX_WORKERS=2
OUTBOX_POLL_INTERVAL_S=1.0
OUTBOX_MAX_ATTEMPTS=6
INBOUND_RATE_LIMIT_PER_MINUTE=30

# ---------------------------------------------------------------- consola ---
# Clave de servicio con alcance de supervisión. Sirve para el arranque, cuando
# todavía no existe ningún agente, y para integraciones. Los agentes entran con
# usuario y contraseña; cree el primero con scripts/create_agent.py.
# Obligatoria cuando ENVIRONMENT=prod.
ADMIN_API_KEY=
# Marca la cookie de sesión como Secure. En una red local sin TLS debe quedar en
# false: el navegador descartaría una cookie Secure servida por HTTP. Con el
# proxy inverso del perfil `tls` delante, póngala en true.
SESSION_COOKIE_SECURE=false
# Orígenes permitidos, separados por comas. En red local conviene acotarlo a la
# dirección del servidor en lugar de dejar el comodín.
CORS_ALLOW_ORIGINS=*

# --------------------------------------------------------- proxy inverso ----
# Solo con nginx (u otro proxy) delante. Lo lee uvicorn, no la aplicación: es
# la lista de direcciones cuyas cabeceras X-Forwarded-* se aceptan como
# ciertas. Por omisión uvicorn solo confía en 127.0.0.1, así que un proxy en
# otro contenedor queda descartado en silencio: el servicio vería `http` donde
# el navegador usó `https` y la validación estricta de SAML fallaría al
# comparar el destino de la aserción. Deje `*` únicamente si el 8000 ya no
# está publicado a la red (ver docker-compose.yml); si lo está, indique la
# dirección concreta del proxy.
# FORWARDED_ALLOW_IPS=*
